# --- Django core ---
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- MySQL database ---
DB_NAME=voice_clone_db
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Voice clone detection model ---
# Any HuggingFace audio-classification model fine-tuned for
# spoof / deepfake / synthetic-voice detection. Swap freely.
DETECTION_MODEL_NAME=MelodyMachine/Deepfake-audio-detection-V2
DETECTION_DEVICE=cpu

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=15
